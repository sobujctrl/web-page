{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Represents an incoming unified lead from Facebook, Messenger, WhatsApp, or manual intake.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the lead" },
        "name": { "type": "string", "description": "Full name of the lead" },
        "phone": { "type": "string", "description": "Phone number in BD normalized format" },
        "source": { "type": "string", "description": "Primary lead source" },
        "sources": { "type": "array", "description": "List of sources the lead has contacted through" },
        "messengerId": { "type": "string", "description": "Facebook Messenger PSID" },
        "message": { "type": "string", "description": "Lead message text" },
        "lastMessage": { "type": "string", "description": "Latest incoming message" },
        "lastMessageAt": { "type": "string", "description": "ISO timestamp of latest message" },
        "status": { "type": "string", "description": "Lead pipeline status" },
        "tags": { "type": "array", "description": "Lead categorization tags" },
        "isStarred": { "type": "boolean", "description": "Starred or favorited status" },
        "assignedTo": { "type": "string", "description": "Assigned team member" },
        "followUpDate": { "type": "string", "description": "Scheduled follow up date" },
        "notes": { "type": "array", "description": "Internal staff notes" },
        "activities": { "type": "array", "description": "Audit trail and history of lead activities" },
        "createdAt": { "type": "string", "description": "Lead creation timestamp" },
        "pageId": { "type": "string", "description": "Facebook Page ID where interaction happened" },
        "pageName": { "type": "string", "description": "Facebook Page name where interaction happened" },
        "lastChannel": { "type": "string", "description": "Channel of latest interaction: comment or messenger" },
        "lastPostId": { "type": "string", "description": "Facebook post ID" },
        "lastPostLink": { "type": "string", "description": "Facebook post URL" }
      },
      "required": ["name", "source"]
    },
    "FacebookConnectedPage": {
      "title": "FacebookConnectedPage",
      "description": "Represents a connected Facebook Page with its Page Access Token for automated lead sync.",
      "type": "object",
      "properties": {
        "pageId": { "type": "string", "description": "Facebook Page ID" },
        "name": { "type": "string", "description": "Facebook Page name" },
        "token": { "type": "string", "description": "Facebook Page Access Token" },
        "connectedAt": { "type": "string", "description": "ISO timestamp when the page was connected" },
        "category": { "type": "string", "description": "Facebook Page category" },
        "subscribed": { "type": "boolean", "description": "Whether webhooks are subscribed" }
      },
      "required": ["pageId", "name", "token", "connectedAt"]
    },
    "PageOwner": {
      "title": "PageOwner",
      "description": "Lookup index mapping a Facebook Page ID to the application user UID for n8n webhook routing.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID of the owner" },
        "pageId": { "type": "string", "description": "Facebook Page ID" },
        "name": { "type": "string", "description": "Facebook Page name" },
        "connectedAt": { "type": "string", "description": "ISO timestamp of connection" }
      },
      "required": ["uid", "pageId"]
    }
  },
  "firestore": {
    "/users/{userId}/leads/{leadId}": {
      "schema": "Lead",
      "description": "Per-user unified leads collection. Each authenticated user owns and accesses only their own leads."
    },
    "/users/{userId}/pages/{pageId}": {
      "schema": "FacebookConnectedPage",
      "description": "Per-user connected Facebook Pages subcollection."
    },
    "/pageOwners/{pageId}": {
      "schema": "PageOwner",
      "description": "Global page ID lookup index mapping pageId to user UID for n8n webhook intake."
    }
  }
}
